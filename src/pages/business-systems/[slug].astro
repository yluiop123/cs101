---
// 业务系统详情页：由 src/data/business-systems.ts 生成，每条系统一个页面
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import BizSystemDetail from '@/components/business/BizSystemDetail.astro';
import { bizCategories } from '@/data/business-systems';

export function getStaticPaths() {
  return bizCategories.flatMap((category) =>
    category.systems.map((system) => ({
      params: { slug: system.slug },
      props: { categoryId: category.id, systemSlug: system.slug },
    })),
  );
}

const { categoryId, systemSlug } = Astro.props as { categoryId: string; systemSlug: string };
const category = bizCategories.find((item) => item.id === categoryId)!;
const system = category.systems.find((item) => item.slug === systemSlug)!;
const title = system.abbr ? `${system.abbr} · ${system.name}` : system.name;
---

<StarlightPage frontmatter={{ title, description: system.summary }}>
  <BizSystemDetail category={category} system={system} />
</StarlightPage>
