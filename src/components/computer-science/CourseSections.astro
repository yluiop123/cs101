---
import zhCourses from '@/data/computer-science/zh.json';
import ossuCourses from '@/data/computer-science/ossu.json';

interface Resource {
  title?: string;
  url?: string;
  lang?: string;
  type?: string;
}
interface ResourceGroup {
  name?: string;
  items?: Resource[];
}
interface CourseItem {
  title?: string;
  description?: string;
  optional?: boolean;
  resources?: ResourceGroup[];
}
interface Category {
  id?: string;
  title?: string;
  items?: CourseItem[];
}

interface Props {
  source: 'zh' | 'ossu';
}

const { source } = Astro.props as Props;
const categories = (((source === 'ossu' ? ossuCourses : zhCourses) ?? []) as Category[]).filter(
  (category) => (category.items ?? []).length > 0,
);

function resourceCount(item: CourseItem) {
  return (item.resources ?? []).reduce((sum, group) => sum + (group.items?.length ?? 0), 0);
}
---

{
  categories.map((category) => (
    <section class="cs-course-section" id={category.id}>
      <h2>
        {category.title}
        <span class="cs-course-count">{(category.items ?? []).length} 门</span>
      </h2>
      <div class="cs-course-grid">
        {(category.items ?? []).map((item) => (
          <article class="cs-course-card">
            <h3>
              {item.title}
              {item.optional && <span class="cs-badge">选修</span>}
            </h3>
            {item.description && <p>{item.description}</p>}
            {resourceCount(item) > 0 && (
              <details class="cs-resource-details">
                <summary>学习资源（{resourceCount(item)}）</summary>
                {(item.resources ?? []).map((group) => (
                  <div class="cs-resource-group">
                    <strong>{group.name}</strong>
                    <ul>
                      {(group.items ?? []).map((resource) => (
                        <li>
                          {resource.url ? (
                            <a href={resource.url} target="_blank" rel="noreferrer">
                              {resource.title}
                              {resource.lang === 'en' && <span class="cs-resource-lang">EN</span>}
                            </a>
                          ) : (
                            resource.title
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </details>
            )}
          </article>
        ))}
      </div>
    </section>
  ))
}
