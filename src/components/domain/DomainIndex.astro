---
import { getSeries } from '@/lib/content';
import CardSection from '@/components/shared/CardSection.astro';
import { routePlan, tierSlugs } from '@/data/route-plan';
import { domains, domainCategories } from '@/data/domains';
import type { CardSectionData } from '@/data/cards';

const series = await getSeries();
const available = new Set(series.map((item) => item.slug));

const cards = domains.map((domain) => {
  const tiers = routePlan[`domain-${domain.slug}`] ?? [];
  // 每条路线的技术项去重后统计：已上线 = 站内已有该教程内容
  const items = [...new Set(tiers.flatMap((tier) => tierSlugs(tier)))];
  const learnable = items.filter((slug) => available.has(slug)).length;
  return { ...domain, tiers: tiers.length, total: items.length, learnable };
});

const sections: CardSectionData[] = domainCategories.map((category) => ({
  id: `cat-${category.id}`,
  title: category.name,
  items: cards
    .filter((card) => card.category === category.id)
    .map((card) => ({
      title: card.name,
      href: `/domain/${card.slug}/`,
      meta: `${card.tiers} 阶段 · ${card.total} 项`,
    })),
}));
---

<div class="cs-domain">
  {sections.map((section) => <CardSection {...section} />)}
</div>
