---
import { getCollection } from 'astro:content';
import RouteSections from '@/components/shared/RouteSections.astro';
import { domainCatalog } from '@/data/entries';
import type { RouteItem } from '@/data/model/route-model';

// 应用领域 = 一条路线：8 个分类分节，卡片是各条领域路线。
// 有没有路线页由 docs 集合决定：content/docs/domain/<slug>.mdx 存在就点亮，否则标成「规划中」虚线卡。
const existing = new Set(
  (await getCollection('docs'))
    .filter((entry) => entry.id.startsWith('domain/') && entry.id !== 'domain/index')
    .map((entry) => entry.id.slice('domain/'.length)),
);

const tiers = domainCatalog.map((tier) => ({
  ...tier,
  items: tier.items.map((item) => {
    const routeItem: RouteItem = typeof item === 'string' ? { id: item } : item;
    const slug = routeItem.id.replace(/^domain-/, '');
    return existing.has(slug) ? routeItem : { ...routeItem, tag: 'planned' as const };
  }),
}));
---

<RouteSections tiers={tiers} />
