---
import { getSeriesBySlug } from '@/lib/content';
import { withBase } from '@/lib/utils';

interface Props {
  series: string;
}

const { series } = Astro.props as Props;
const data = await getSeriesBySlug(series);
---

{
  data && (
    <>
      {data.chapters[0] && (
        <p class="cs-series-start">
          <a class="cs-btn cs-btn-primary" href={withBase(`/${data.chapters[0].id}/`)}>
            开始学习 →
          </a>
          <span class="cs-series-start-title">{data.chapters[0].title}</span>
        </p>
      )}
      <p class="cs-series-progress" data-series-progress>
        已完成 0/{data.chapters.length} 章
      </p>
      <ol class="cs-chapter-list">
        {data.chapters.map((chapter, index) => (
          <li class="cs-chapter-item">
            <a href={withBase(`/${chapter.id}/`)} data-chapter-id={chapter.id}>
              <span class="cs-chapter-num">{String(index + 1).padStart(2, '0')}</span>
              <span class="cs-chapter-title">{chapter.title}</span>
              <span class="cs-chapter-meta">
                {chapter.duration ? `约 ${chapter.duration} 分钟` : ''}
              </span>
            </a>
          </li>
        ))}
      </ol>
      <script is:inline>
        (() => {
          const KEY = 'cs101:progress:v1';
          const read = () => {
            try {
              return JSON.parse(localStorage.getItem(KEY) || '{}');
            } catch {
              return {};
            }
          };
          const paint = () => {
            const state = read();
            const done = state.completed || {};
            const links = [...document.querySelectorAll('[data-chapter-id]')];
            if (!links.length) return;
            links.forEach((link) => {
              link.classList.toggle('is-complete', Boolean(done[link.dataset.chapterId]));
            });
            const completed = links.filter((link) => done[link.dataset.chapterId]).length;
            const label = document.querySelector('[data-series-progress]');
            if (label) label.textContent = `已完成 ${completed}/${links.length} 章`;
          };
          paint();
          document.addEventListener('cs101:progress', paint);
          window.addEventListener('storage', paint);
        })();
      </script>
    </>
  )
}
