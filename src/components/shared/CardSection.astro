---
import Card from '@/components/shared/Card.astro';
import { withBase } from '@/lib/utils';
import { tagVariant, type CardSectionData } from '@/data/model/cards';
import { roleLabels } from '@/data/model/route-model';

type Props = CardSectionData;

const {
  id,
  title,
  more,
  tag,
  note,
  items,
  groups,
  showKind = true,
  density = 'default',
  columns,
} = Astro.props as Props;

// 有 groups = 二级「多选一」分节（如大前端 → 框架选型 → 各框架教程）
const choice = Boolean(groups?.length);
const tagSuffix = tagVariant(tag);
---

<section
  id={id}
  class:list={[
    'cs-card-section',
    choice && 'cs-card-section--choice',
    density === 'compact' && 'cs-card-section--compact',
    columns === 2 && 'cs-card-section--cols-2',
  ]}
>
  <div class="cs-section-head">
    <h2 class="cs-section-title">
      {title}
      {tag && (
        <span class:list={['cs-section-tag', tagSuffix && `cs-section-tag--${tagSuffix}`]}>
          {tag.label}
        </span>
      )}
    </h2>
    {more && <a class="cs-section-more" href={withBase(more.href)}>{more.label ?? '学习路线 →'}</a>}
  </div>

  {note && <p class="cs-section-note">{note}</p>}

  {choice ? (
    <div class="cs-choice-grid">
      {groups?.map((group, index) => (
        <div
          id={id ? `${id}-${index}` : undefined}
          class:list={['cs-choice-option', group.role && `cs-choice-option--${group.role}`]}
        >
          <h3 class="cs-choice-title">
            {group.title}
            {group.role && (
              <span class:list={['cs-badge', `cs-badge--${group.role}`]}>
                {roleLabels[group.role]}
              </span>
            )}
          </h3>
          <ul class="cs-tut-grid cs-tut-grid--stack">
            {group.items.map((item) => (
              <li>
                <Card item={item} showKind={showKind} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  ) : (
    <ul class="cs-tut-grid">
      {(items ?? []).map((item) => (
        <li>
          <Card item={item} showKind={showKind} />
        </li>
      ))}
    </ul>
  )}
</section>
