---
import { withBase } from '@/lib/utils';
import { kindLabels, kindOfHref, type CardItem, type CardKind } from '@/data/model/cards';

interface Props {
  item: CardItem;
  /** 省略 kind 时是否按 href 推断类型标记；路线页把它设为 false */
  showKind?: boolean;
}

const { item, showKind = true } = Astro.props as Props;

// 卡片类型标记：显式写了 kind 就用它，否则按 href 推断（教程 / 路线）
const kind: CardKind | undefined = item.kind ?? (showKind ? kindOfHref(item.href) : undefined);
const hasTail = Boolean(kind || item.badges?.length || item.meta);
---

{
  item.href ? (
    <a class="cs-tut-card" href={withBase(item.href)} title={item.title}>
      <span class="cs-tut-name">
        <span class="cs-tut-title">{item.title}</span>
      </span>
      {hasTail && (
        <span class="cs-tut-tail">
          {kind && (
            <span class:list={['cs-kind', `cs-kind--${kind}`]}>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {kind === 'tutorial' ? (
                  <>
                    <path d="M12 7v14" />
                    <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" />
                  </>
                ) : (
                  <>
                    <circle cx="6" cy="19" r="3" />
                    <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15" />
                    <circle cx="18" cy="5" r="3" />
                  </>
                )}
              </svg>
              {kindLabels[kind]}
            </span>
          )}
          {item.badges?.map((badge) => (
            <span class:list={['cs-badge', badge.tone && `cs-badge--${badge.tone}`]}>
              {badge.label}
            </span>
          ))}
          {item.meta && <span class="cs-tut-meta">{item.meta}</span>}
        </span>
      )}
    </a>
  ) : (
    <span class="cs-tut-card is-planned" title={item.title}>
      <span class="cs-tut-name">
        <span class="cs-tut-title">{item.title}</span>
      </span>
      {hasTail && (
        <span class="cs-tut-tail">
          {item.badges?.map((badge) => (
            <span class:list={['cs-badge', badge.tone && `cs-badge--${badge.tone}`]}>
              {badge.label}
            </span>
          ))}
          {item.meta && <span class="cs-tut-meta">{item.meta}</span>}
        </span>
      )}
    </span>
  )
}
