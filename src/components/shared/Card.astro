---
import { Icon } from 'astro-icon/components';
import { withBase } from '@/lib/utils';
import {
  kindLabels,
  tagLabels,
  type RouteItem,
  type RouteKind,
  type RouteTag,
} from '@/data/model/route-model';

// 一张卡片：只负责渲染，标题 / 入口 / 类型 / 标签都由 RouteSections 解析好后传进来。
interface Props {
  item: RouteItem;
  /** 已解析好的标题（title / seriesMeta / 目录配置） */
  title: string;
  /** 已解析好的站内入口；外部引用与规划中没有 */
  href?: string;
  /** 卡片类型标记；由 RouteSections 按 markKind 策略决定（不传 = 不标） */
  kind?: RouteKind;
  /** 状态标签：必学 / 推荐 / 主流 / 可选 / 小众 / 规划中 */
  tag?: RouteTag;
}

const { item, title, href, kind, tag } = Astro.props as Props;

const kindIcons: Record<RouteKind, string> = {
  tutorial: 'lucide:book-open',
  external: 'lucide:external-link',
  route: 'lucide:route',
};

// 三种卡片：有 href = 站内链接；外部引用 = 按钮（点开右侧抽屉）；都没有 = 规划中虚线卡
const refId = item.kind === 'external' ? item.id : undefined;
const Tag = refId ? 'button' : 'a';
const interactive = Boolean(href || refId);
const hasTail = Boolean(kind || tag);
---

{
  interactive ? (
    <Tag
      class:list={['cs-tut-card', refId && 'cs-tut-card--ref']}
      href={href ? withBase(href) : undefined}
      type={refId ? 'button' : undefined}
      data-cs-ref={refId}
      aria-haspopup={refId ? 'dialog' : undefined}
      title={title}
    >
      <span class="cs-tut-name">
        <span class="cs-tut-title">{title}</span>
      </span>
      {hasTail && (
        <span class="cs-tut-tail">
          {kind && (
            <span class:list={['cs-kind', `cs-kind--${kind}`]}>
              <Icon name={kindIcons[kind]} aria-hidden="true" />
              {kindLabels[kind]}
            </span>
          )}
          {tag && (
            <span class:list={['cs-badge', `cs-badge--${tag}`]}>{tagLabels[tag]}</span>
          )}
        </span>
      )}
    </Tag>
  ) : (
    <span class="cs-tut-card is-planned" title={title}>
      <span class="cs-tut-name">
        <span class="cs-tut-title">{title}</span>
      </span>
      {hasTail && (
        <span class="cs-tut-tail">
          {kind && (
            <span class:list={['cs-kind', `cs-kind--${kind}`]}>
              <Icon name={kindIcons[kind]} aria-hidden="true" />
              {kindLabels[kind]}
            </span>
          )}
          {tag && (
            <span class:list={['cs-badge', `cs-badge--${tag}`]}>{tagLabels[tag]}</span>
          )}
        </span>
      )}
    </span>
  )
}
