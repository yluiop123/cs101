---
// 全站唯一的「目录页 / 路线页」组件。
// 首页、业务系统、全部技术路线、各条路线、计算机科学课程页都用它；
// 页面数据写在引用它的 MDX frontmatter 的 route 字段里。
import RouteSections from '@/components/shared/RouteSections.astro';
import type { PageConfig } from '@/data/pages';
const { entry } = Astro.locals.starlightRoute;
const config = (entry.data as { route?: PageConfig }).route;
if (!config) throw new Error(`缺少页面配置：${entry.id}`);
const { tiers, options = {} } = config;
const {
  markKind = 'explicit',
  density,
  columns,
  legend = true,
} = options;
const isHome = !entry.id || entry.id === 'index';

---

<div class:list={[isHome && 'cs-home']}>
  <RouteSections
    tiers={tiers}
    markKind={markKind}
    density={density}
    columns={columns}
    legend={legend}
  />
</div>
