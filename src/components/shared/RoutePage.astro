---
// 全站唯一的「目录页 / 路线页」组件。
// 首页、应用领域、业务系统、全部技术路线、各条路线、计算机科学课程页都用它；
// 页面数据由引用它的 MDX 从 src/data/pages/<page>.json 显式传入。
import { getCollection } from 'astro:content';
import FavoriteButton from '@/components/progress/FavoriteButton.tsx';
import RouteSections from '@/components/shared/RouteSections.astro';
import type { RouteItem, RouteTier } from '@/data/model/route-model';
import { pageConfigKey, type PageConfig } from '@/data/pages';

interface Props {
  config: PageConfig;
}

const { config } = Astro.props;
const { entry } = Astro.locals.starlightRoute;
const { tiers, options = {} } = config;
const {
  markKind = 'explicit',
  density,
  columns,
  legend = true,
  detectPlanned = false,
  favorite = false,
} = options;
const isHome = !entry.id || entry.id === 'index';

// 应用领域总览：docs 集合里存在 domain/<slug>.mdx 才点亮，否则标成「规划中」
let resolvedTiers: RouteTier[] = tiers;
if (detectPlanned) {
  const existing = new Set(
    (await getCollection('docs'))
      .filter((item) => item.id.startsWith('domain/') && item.id !== 'domain/index')
      .map((item) => item.id.slice('domain/'.length)),
  );
  resolvedTiers = tiers.map((tier) => ({
    ...tier,
    items: tier.items.map((item) => {
      const routeItem: RouteItem = typeof item === 'string' ? { id: item } : item;
      const slug = routeItem.id.replace(/^domain-/, '');
      return existing.has(slug) ? routeItem : { ...routeItem, tag: 'planned' as const };
    }),
  }));
}

---

<div class:list={[isHome && 'cs-home']}>
  {favorite && (
    <div class="cs-route-actions">
      <FavoriteButton
        client:visible
        slug={`route:${pageConfigKey(entry.id)}`}
        label="收藏路线"
        activeLabel="已收藏路线"
      />
    </div>
  )}
  <RouteSections
    tiers={resolvedTiers}
    markKind={markKind}
    density={density}
    columns={columns}
    legend={legend}
  />
</div>
