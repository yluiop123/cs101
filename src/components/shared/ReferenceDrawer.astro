---
import { Icon } from 'astro-icon/components';
import type { RouteItem } from '@/data/model/route-model';

// 外部引用抽屉：卡片点开后从右侧滑出，展示课程简介与全部学习资源（站内不跳走）。
// 计算机科学（国内教程 / 国际教程）整页共用这一个抽屉，面板按条目 id 切换。
interface Props {
  /** 课程序列（会过滤出 kind: 'external' 的条目）；面板 id 用条目 id */
  items: RouteItem[];
}

const { items } = Astro.props as Props;
const refs = items.filter((item) => (item.kind ?? 'tutorial') === 'external');
---

<dialog class="cs-drawer" id="cs-ref-drawer" aria-labelledby="cs-ref-drawer-kicker">
  <div class="cs-drawer-head">
    <p class="cs-drawer-kicker" id="cs-ref-drawer-kicker">
      <span class="cs-drawer-dot" aria-hidden="true" />
      外部引用 · 课程详情
    </p>
    <button type="button" class="cs-drawer-close" data-cs-drawer-close aria-label="关闭">
      <Icon name="lucide:x" aria-hidden="true" />
    </button>
  </div>
  <div class="cs-drawer-body">
    {
      refs.map((item) => (
        <article class="cs-ref-panel" data-cs-ref-panel={item.id} hidden>
          <h2 class="cs-ref-title" id={`ref-${item.id}`}>
            {item.title}
          </h2>
          <div class="cs-ref-actions">
            <button
              type="button"
              class="cs-btn"
              data-ext-action="favorite"
              data-ext-slug={`external:${item.id}`}
              aria-pressed="false"
            >
              <Icon name="lucide:star" aria-hidden="true" />
              <span data-ext-label>收藏课程</span>
            </button>
            <button
              type="button"
              class="cs-btn cs-btn-primary"
              data-ext-action="complete"
              data-ext-slug={`external:${item.id}`}
              aria-pressed="false"
            >
              <Icon name="lucide:check" aria-hidden="true" />
              <span data-ext-label>标记完成课程</span>
            </button>
          </div>
          {item.external?.description && <p class="cs-ref-desc">{item.external.description}</p>}
          {(item.external?.resources ?? []).map((group) => (
            <section class="cs-ref-group">
              {group.name && <h3 class="cs-ref-group-title">{group.name}</h3>}
              <ul class="cs-ref-list">
                {group.items.map((resource) =>
                  resource.url ? (
                    <li>
                      <a
                        class="cs-ref-link"
                        href={resource.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <span class="cs-ref-link-text">{resource.title}</span>
                        <Icon name="lucide:external-link" class="cs-ref-link-icon" aria-hidden="true" />
                      </a>
                    </li>
                  ) : (
                    <li>
                      <span class="cs-ref-link cs-ref-link--plain">{resource.title}</span>
                    </li>
                  ),
                )}
              </ul>
            </section>
          ))}
          <p class="cs-ref-hint">站外资源将在新标签页打开</p>
        </article>
      ))
    }
  </div>
</dialog>

<script>
  import { PROGRESS_EVENT, readProgress, toggleComplete, toggleFavorite } from '@/lib/progress';

  const drawer = document.querySelector<HTMLDialogElement>('#cs-ref-drawer');
  if (drawer) {
    const panels = Array.from(drawer.querySelectorAll<HTMLElement>('[data-cs-ref-panel]'));
    let lastTrigger: HTMLElement | null = null;

    const open = (id: string, trigger: HTMLElement | null) => {
      const panel = panels.find((item) => item.dataset.csRefPanel === id);
      if (!panel) return;
      lastTrigger = trigger;
      for (const item of panels) item.hidden = item !== panel;
      if (!drawer.open) drawer.showModal();
      drawer.setAttribute('aria-labelledby', `ref-${id}`);
      drawer.querySelector<HTMLElement>('[data-cs-drawer-close]')?.focus();
      document.documentElement.classList.add('cs-drawer-open');
    };

    document.addEventListener('click', (event) => {
      const target = event.target as Element | null;
      if (target?.closest('[data-cs-drawer-close]')) {
        drawer.close();
        return;
      }
      const trigger = target?.closest<HTMLElement>('[data-cs-ref]');
      const id = trigger?.dataset.csRef;
      if (trigger && id) {
        event.preventDefault();
        open(id, trigger);
      }
    });

    // 点遮罩（dialog 自身）关闭；按 Esc 由原生 cancel 关闭
    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) drawer.close();
    });

    drawer.addEventListener('close', () => {
      document.documentElement.classList.remove('cs-drawer-open');
      drawer.setAttribute('aria-labelledby', 'cs-ref-drawer-kicker');
      lastTrigger?.focus();
      lastTrigger = null;
    });

    // 学习中心收藏的外部教程用 #ref-<id> 直接打开对应面板
    const openFromHash = () => {
      const match = window.location.hash.match(/^#ref-(.+)$/);
      if (match) open(decodeURIComponent(match[1]), null);
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  }

  // 外部课程按「教程」收藏 / 完成，不写入章节进度
  const paintExternalActions = () => {
    const state = readProgress();
    for (const button of document.querySelectorAll<HTMLElement>('[data-ext-action]')) {
      const slug = button.dataset.extSlug ?? '';
      const isFavorite = button.dataset.extAction === 'favorite';
      const active = isFavorite ? state.favorites.includes(slug) : Boolean(state.completed[slug]);
      button.classList.toggle('is-active', active);
      button.classList.toggle('cs-btn-done', active);
      if (!isFavorite) button.classList.toggle('cs-btn-primary', !active);
      button.setAttribute('aria-pressed', String(active));
      const label = button.querySelector<HTMLElement>('[data-ext-label]');
      if (label) {
        label.textContent = isFavorite
          ? active
            ? '已收藏课程'
            : '收藏课程'
          : active
            ? '已完成课程'
            : '标记完成课程';
      }
    }
  };

  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>('[data-ext-action]');
    if (!button) return;
    const slug = button.dataset.extSlug;
    if (!slug) return;
    if (button.dataset.extAction === 'favorite') toggleFavorite(slug);
    else toggleComplete(slug);
  });

  window.addEventListener(PROGRESS_EVENT, paintExternalActions);
  window.addEventListener('storage', paintExternalActions);
  paintExternalActions();
</script>
