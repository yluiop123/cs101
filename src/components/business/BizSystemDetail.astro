---
import { withBase } from '@/lib/utils';
import type { BizCategory, BizSystem } from '@/data/business-systems';

interface Props {
  category: BizCategory;
  system: BizSystem;
}

const { category, system } = Astro.props as Props;
---

<p class="cs-biz-owner">
  属于
  <a href={withBase(`/business-systems/#${category.id}`)}>{category.name}</a>
</p>

<h2>核心作用</h2>
<p>{system.summary}</p>

<h2>这类系统常用的技术栈</h2>
<ul class="cs-biz-related">
  {
    category.related.map((item) => (
      <li>
        <a href={withBase(item.href)}>{item.title}</a>
      </li>
    ))
  }
</ul>

<p class="cs-biz-note">这个系统的开发教程还在整理中，暂以上面的技术栈作为入门方向。</p>
