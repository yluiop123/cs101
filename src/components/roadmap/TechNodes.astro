---
import { getSeries } from '@/lib/content';
import {
  routePlan,
  roleLabels,
  roleNotes,
  normalizeItem,
  type RouteItemRole,
} from '@/data/route-plan';
import TechCard from '@/components/roadmap/TechCard.astro';

interface Props {
  page: string;
}

const { page } = Astro.props as Props;
const tiers = routePlan[page] ?? [];
const series = await getSeries();
const bySlug = new Map(series.map((item) => [item.slug, item]));

// 图例只展示这条路线实际用到的状态（必学 / 推荐 / 主流 / 可选 / 小众）
const legendOrder: RouteItemRole[] = ['required', 'recommended', 'popular', 'optional', 'niche'];
const usedRoles = new Set<RouteItemRole>();
for (const tier of tiers) {
  if (tier.required) usedRoles.add('required');
  for (const item of tier.items) {
    const role = normalizeItem(item).role;
    if (role) usedRoles.add(role);
  }
  for (const option of tier.options ?? []) {
    if (option.role) usedRoles.add(option.role);
    for (const item of option.items) {
      const role = normalizeItem(item).role;
      if (role) usedRoles.add(role);
    }
  }
}
const legendRoles = legendOrder.filter((role) => usedRoles.has(role));

const chaptersOf = (slug: string) => bySlug.get(slug)?.chapters.length;
---

{
  tiers.length === 0 && <p class="cs-empty">这条路线正在整理中。</p>
}

{
  legendRoles.length > 0 && (
    <p class="cs-legend">
      {legendRoles.map((role) => (
        <>
          <span class:list={['cs-badge', `cs-badge--${role}`]}>{roleLabels[role]}</span>
          <span class="cs-legend-text">{roleNotes[role]}</span>
        </>
      ))}
      <span class="cs-legend-text">虚线卡片 · 教程还在整理中</span>
    </p>
  )
}

{
  tiers.map((tier, index) => (
    <section id={`tier-${index}`} class:list={['cs-tier', tier.kind === 'choice' && 'cs-tier--choice']}>
      <div class="cs-section-head">
        <h2 class="cs-section-title">
          {tier.name}
          {tier.required && <span class="cs-tier-badge cs-tier-badge--required">必学</span>}
          {tier.kind === 'choice' && tier.options?.length && (
            <span class="cs-tier-badge cs-tier-badge--choice">{tier.options.length} 选 1</span>
          )}
        </h2>
      </div>
      {tier.note && <p class="cs-tier-note">{tier.note}</p>}

      {tier.options?.length ? (
        <div class="cs-choice-grid">
          {tier.options.map((option, optionIndex) => (
            <div
              id={`tier-${index}-${optionIndex}`}
              class:list={[
                'cs-choice-option',
                option.role && `cs-choice-option--${option.role}`,
              ]}
            >
              <h3 class="cs-choice-title">
                {option.name}
                {option.role && (
                  <span class:list={['cs-badge', `cs-badge--${option.role}`]}>
                    {roleLabels[option.role]}
                  </span>
                )}
              </h3>
              <ul class="cs-tut-grid cs-tut-grid--stack">
                {option.items.map((item) => (
                  <li>
                    <TechCard item={item} chapters={chaptersOf(typeof item === 'string' ? item : item.slug)} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ) : (
        <ul class="cs-tut-grid">
          {tier.items.map((item) => (
            <li>
              <TechCard
                item={item}
                role={tier.required ? 'required' : undefined}
                chapters={chaptersOf(typeof item === 'string' ? item : item.slug)}
              />
            </li>
          ))}
        </ul>
      )}
    </section>
  ))
}
