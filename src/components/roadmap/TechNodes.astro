---
import { getSeries } from '@/lib/content';
import {
  routePlan,
  roleLabels,
  roleNotes,
  seriesMeta,
  normalizeItem,
  itemRole,
  tierSlugs,
  type RouteItem,
  type RouteItemRole,
} from '@/data/route-plan';
import CardSection from '@/components/shared/CardSection.astro';
import type { CardItem, CardSectionData } from '@/data/cards';

interface Props {
  page: string;
}

const { page } = Astro.props as Props;
const tiers = routePlan[page] ?? [];
const series = await getSeries();
const bySlug = new Map(series.map((item) => [item.slug, item]));

// 图例只展示这条路线实际用到的状态（必学 / 推荐 / 主流 / 可选 / 小众）
const legendOrder: RouteItemRole[] = ['required', 'recommended', 'popular', 'optional', 'niche'];
const usedRoles = new Set<RouteItemRole>();
for (const tier of tiers) {
  if (tier.required) usedRoles.add('required');
  for (const item of tier.items) {
    const role = normalizeItem(item).role;
    if (role) usedRoles.add(role);
  }
  for (const option of tier.options ?? []) {
    if (option.role) usedRoles.add(option.role);
    for (const item of option.items) {
      const role = normalizeItem(item).role;
      if (role) usedRoles.add(role);
    }
  }
}
const legendRoles = legendOrder.filter((role) => usedRoles.has(role));

// 路线里的一个条目 → 一张卡片：教程已有章节才可点，否则是规划中的虚线卡；
// 「跳到另一条路线」的条目额外带上规模提示和「路线」标记。
const toCard = (item: string | RouteItem, inheritedRole?: RouteItemRole): CardItem => {
  const normalized = normalizeItem(item);
  const title = seriesMeta[normalized.slug] ?? normalized.slug;
  const role = itemRole(item, inheritedRole);
  const badges = role ? [{ label: roleLabels[role], tone: role }] : [];

  if (normalized.kind === 'route') {
    const targetTiers = routePlan[normalized.slug] ?? [];
    const count = new Set(targetTiers.flatMap((tier) => tierSlugs(tier))).size;
    return {
      title,
      href: `/tech-stack/${normalized.slug}/`,
      kind: 'route',
      meta: `${targetTiers.length} 板块 · ${count} 项`,
      badges,
    };
  }

  const chapters = bySlug.get(normalized.slug)?.chapters.length ?? 0;
  return {
    title,
    href: chapters > 0 ? `/tutorials/${normalized.slug}/` : undefined,
    badges,
  };
};

// 一个阶段 = 一个卡片分节；选型阶段用 groups 渲染成「多选一」的面板
const sections: CardSectionData[] = tiers.map((tier, index) => {
  const choice = Boolean(tier.options?.length);
  return {
    id: `tier-${index}`,
    title: tier.name,
    tag: tier.required
      ? { label: roleLabels.required, tone: 'required' }
      : choice
        ? { label: `${tier.options?.length} 选 1`, tone: 'choice' }
        : undefined,
    note: tier.note,
    showKind: false,
    density: 'compact',
    items: choice
      ? undefined
      : tier.items.map((item) => toCard(item, tier.required ? 'required' : undefined)),
    groups: choice
      ? tier.options?.map((option) => ({
          title: option.name,
          role: option.role,
          items: option.items.map((item) => toCard(item, option.role)),
        }))
      : undefined,
  };
});
---

{tiers.length === 0 && <p class="cs-empty">这条路线正在整理中。</p>}

{
  legendRoles.length > 0 && (
    <p class="cs-legend">
      {legendRoles.map((role) => (
        <>
          <span class:list={['cs-badge', `cs-badge--${role}`]}>{roleLabels[role]}</span>
          <span class="cs-legend-text">{roleNotes[role]}</span>
        </>
      ))}
      <span class="cs-legend-text">虚线卡片 · 教程还在整理中</span>
    </p>
  )
}

<div class="cs-card-page">
  {sections.map((section) => <CardSection {...section} />)}
</div>
