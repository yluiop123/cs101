---
import { getSeries } from '@/lib/content';
import { routePlan, seriesMeta } from '@/data/route-plan';
import { withBase } from '@/lib/utils';

interface Props {
  page: string;
}

const { page } = Astro.props as Props;
const tiers = (routePlan as Record<string, { name: string; items: string[] }[]>)[page] ?? [];
const series = await getSeries();
const bySlug = new Map(series.map((item) => [item.slug, item]));
---

{
  tiers.length === 0 && <p class="cs-empty">这条路线正在整理中。</p>
}

{
  tiers.map((tier, index) => (
    <section id={`tier-${index}`} class="cs-tier">
      <div class="cs-section-head">
        <h2 class="cs-section-title">{tier.name}</h2>
      </div>
      <ul class="cs-tut-grid">
        {tier.items.map((slug) => {
          const found = bySlug.get(slug);
          const title = seriesMeta[slug] ?? slug;
          return (
            <li>
              {found ? (
                <a class="cs-tut-card" href={withBase(`/tutorials/${slug}/`)}>
                  <span>{title}</span>
                  <span class="cs-tut-meta">{found.chapters.length} 章</span>
                </a>
              ) : (
                <span class="cs-tut-card is-planned">
                  <span>{title}</span>
                  <span class="cs-tut-meta">敬请期待</span>
                </span>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  ))
}
