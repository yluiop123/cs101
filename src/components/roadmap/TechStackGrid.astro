---
import { routePlan, tierSlugs } from '@/data/route-plan';
import CardSection from '@/components/shared/CardSection.astro';
import type { CardSectionData } from '@/data/cards';

interface TechGroup {
  name: string;
  items: { title: string; slug: string }[];
}

const groups: TechGroup[] = [
  {
    name: '编程语言',
    items: [
      { title: 'Java', slug: 'java' },
      { title: 'Python', slug: 'python' },
      { title: 'Go', slug: 'go' },
      { title: 'Rust', slug: 'rust' },
      { title: 'JavaScript / TypeScript', slug: 'javascript-typescript' },
      { title: '大前端', slug: 'frontend' },
      { title: 'C / C++', slug: 'c-cpp' },
      { title: 'C# 与 .NET', slug: 'c-sharp' },
      { title: 'Kotlin / Swift / Dart', slug: 'kotlin-swift-dart' },
    ],
  },
  {
    name: '数据库',
    items: [
      { title: '数据库技术路线', slug: 'sql-database' },
      { title: 'MySQL', slug: 'mysql' },
      { title: 'PostgreSQL', slug: 'postgresql' },
      { title: 'Redis', slug: 'redis' },
      { title: 'MongoDB', slug: 'mongodb' },
      { title: 'Elasticsearch', slug: 'elasticsearch' },
    ],
  },
  {
    name: '中间件',
    items: [
      { title: '中间件技术路线', slug: 'kafka' },
      { title: 'Nginx', slug: 'nginx' },
    ],
  },
  {
    name: '运维与云',
    items: [
      { title: 'DevOps 与工程工具', slug: 'docker' },
      { title: 'Kubernetes', slug: 'kubernetes' },
    ],
  },
];

// 卡片右侧的规模提示，与首页 / 领域卡片同样式
const scaleOf = (slug: string) => {
  const tiers = routePlan[slug] ?? [];
  const count = new Set(tiers.flatMap((tier) => tierSlugs(tier))).size;
  return `${tiers.length} 阶段 · ${count} 项`;
};

// 一张卡 = 一条技术路线，点进去是该路线的分节教程；
// 这一页全是路线，卡片不再重复「路线」标记，只留规模提示（标题太长会被挤断行）
const sections: CardSectionData[] = groups.map((group) => ({
  title: group.name,
  density: 'compact',
  showKind: false,
  items: group.items.map((item) => ({
    title: item.title,
    href: `/tech-stack/${item.slug}/`,
    meta: scaleOf(item.slug),
  })),
}));
---

<div class="cs-card-page">
  {sections.map((section) => <CardSection {...section} />)}
</div>
