---
import Pagination from './Pagination.astro';
import { withBase } from '@/lib/utils';

const { entry } = Astro.locals.starlightRoute;
const isChapter = Boolean((entry.data as Record<string, unknown>).series);
---

{
  isChapter && (
    <div class="cs-chapter-actions">
      <button type="button" class="cs-btn cs-btn-primary" data-cs-action="complete">
        标记本章完成
      </button>
      <button type="button" class="cs-btn" data-cs-action="favorite">
        收藏本章
      </button>
      <span class="cs-action-hint">进度与收藏将在 M5 接入本地存储</span>
    </div>
  )
}

<Pagination />

<footer class="cs-site-footer">
  <div class="cs-footer-col">
    <h3>CS101</h3>
    <p>中文计算机学习路径：计算机科学 / 技术栈 / 应用领域。</p>
  </div>
  <div class="cs-footer-col">
    <h3>学习</h3>
    <a href={withBase('/tutorials/')}>教程总览</a>
    <a href={withBase('/tech-stack/')}>技术栈路线</a>
    <a href={withBase('/computer-science/')}>计算机科学</a>
  </div>
  <div class="cs-footer-col">
    <h3>关于</h3>
    <p>内容仅供学习参考。</p>
  </div>
</footer>
