---
import { isComputerSciencePath, isHomePath } from '@/data/navigation';
import Pagination from './Pagination.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length) || '/';
const isHome = isHomePath(path);
// 计算机科学的两条课程路线不是教程章节，也不显示「上一章 / 下一章」翻页
const isComputerScience = isComputerSciencePath(path);
---

{!isHome && !isComputerScience && <Pagination />}

<script>
  import '@/scripts/code-run';
</script>
