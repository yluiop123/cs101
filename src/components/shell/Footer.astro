---
import CompleteButton from '@/components/progress/CompleteButton.tsx';
import FavoriteButton from '@/components/progress/FavoriteButton.tsx';
import Pagination from './Pagination.astro';
import { withBase } from '@/lib/utils';

const { entry } = Astro.locals.starlightRoute;
const isChapter = Boolean((entry.data as Record<string, unknown>).series);
---

{
  isChapter && (
    <div class="cs-chapter-actions">
      <CompleteButton client:visible slug={entry.id} />
      <FavoriteButton client:visible slug={entry.id} />
      <span class="cs-action-hint">进度与收藏保存在本机浏览器，无需登录</span>
    </div>
  )
}

<Pagination />

<footer class="cs-site-footer">
  <div class="cs-footer-col">
    <h3>CS101</h3>
    <p>中文计算机学习路径：计算机科学 / 技术栈 / 应用领域。</p>
  </div>
  <div class="cs-footer-col">
    <h3>学习</h3>
    <a href={withBase('/tech-stack/')}>技术栈路线</a>
    <a href={withBase('/domain/')}>应用领域</a>
    <a href={withBase('/computer-science/')}>计算机科学</a>
    <a href={withBase('/playground/')}>代码演练场</a>
  </div>
  <div class="cs-footer-col">
    <h3>关于</h3>
    <p>内容仅供学习参考。</p>
  </div>
</footer>

<script>
  const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
  const SUPPORTED = new Set(['js', 'javascript', 'ts', 'typescript', 'html', 'css']);

  const decorate = () => {
    document.querySelectorAll<HTMLElement>('figure.frame').forEach((figure) => {
      if (figure.querySelector('.cs-code-run')) return;
      const pre = figure.querySelector('pre');
      const codeEl = figure.querySelector('pre code');
      if (!pre || !codeEl) return;
      const rawLang = (pre.getAttribute('data-language') ?? '').toLowerCase();
      const classLang = (codeEl.className.match(/language-([\w-]+)/)?.[1] ?? '').toLowerCase();
      const lang = rawLang || classLang;
      if (!SUPPORTED.has(lang)) return;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'cs-code-run';
      button.textContent = '▷ 运行实例';
      button.addEventListener('click', () => {
        try {
          sessionStorage.setItem(
            'cs101:playground',
            JSON.stringify({ code: codeEl.textContent ?? '', lang }),
          );
        } catch {
          /* ignore */
        }
        window.location.href = `${BASE}/playground/?from=session`;
      });
      figure.appendChild(button);
    });
  };

  decorate();
</script>
