---
import CompleteButton from '@/components/progress/CompleteButton.tsx';
import FavoriteButton from '@/components/progress/FavoriteButton.tsx';
import { defaultSectionRoot, sectionRoot } from '@/data/navigation';
import { pageConfigKey, type PageConfig } from '@/data/pages';
import { seriesMeta } from '@/data/tutorials';
import { getSeriesBySlug } from '@/lib/content';
import { withBase } from '@/lib/utils';

const { entry } = Astro.locals.starlightRoute;
const data = entry.data as Record<string, any>;
const segments = entry.id.split('/').filter(Boolean);

// 首页也显示面包屑与标题；splash 页（如学习中心）只显示标题
const isHomePage = !entry.id || entry.id === 'index';
const isSplash = data.template === 'splash';
const isChapter = Boolean(data.series);
const seriesSlug = data.series as string | undefined;
const isSectionIndex = segments.length === 1;
const routeConfig = (entry.data as { route?: PageConfig }).route;
const isRoutePage = Boolean(routeConfig?.options?.favorite);
const routeSlug = `route:${pageConfigKey(entry.id)}`;

type Crumb = { label: string; href?: string };

// 顶部四个板块是同级：应用领域 / 计算机科学 的页面不再以「首页」为上级
const root = sectionRoot[segments[0] ?? ''] ?? defaultSectionRoot;

const crumbs: Crumb[] = [];
if (!isSplash) {
  if (isHomePage) {
    crumbs.push({ label: '首页' });
  } else if (segments[0] === 'tutorials') {
    crumbs.push({ label: '首页', href: withBase('/') });
    if (segments[1]) {
      const series = await getSeriesBySlug(segments[1]);
      crumbs.push({
        label: series?.title ?? seriesMeta[segments[1]] ?? segments[1],
        href: withBase(`/tutorials/${segments[1]}/`),
      });
    }
  } else if (segments[0] === 'tech-stack') {
    // 技术路线页与教程页同级：面包屑只有「首页 › 当前路线」两层
    crumbs.push({ label: '首页', href: withBase('/') });
    if (!isSectionIndex) crumbs.push({ label: data.title });
  } else if (segments[0] === 'domain' || segments[0] === 'computer-science') {
    crumbs.push(
      isSectionIndex || !root.href
        ? { label: root.label }
        : { label: root.label, href: withBase(root.href) },
    );
    if (!isSectionIndex) crumbs.push({ label: data.title });
  } else if (segments[0] === 'business-systems') {
    // 业务系统是顶层板块：总览页只显示板块名；系统页显示「业务系统 › 系统名 [› 章节]」
    if (isSectionIndex) {
      crumbs.push({ label: '业务系统' });
    } else {
      crumbs.push({ label: '业务系统', href: withBase('/business-systems/') });
      const seriesSlug = `business-${segments[1]}`;
      const series = await getSeriesBySlug(seriesSlug);
      crumbs.push({
        label: series?.title ?? data.title,
        href: isChapter ? withBase(`/business-systems/${segments[1]}/`) : undefined,
      });
    }
  } else {
    crumbs.push({ label: '首页', href: withBase('/') });
  }
}

const difficultyLabels: Record<string, string> = {
  beginner: '入门',
  intermediate: '进阶',
  advanced: '高级',
};
const difficulty = difficultyLabels[data.difficulty as string];
const seriesLabel = data.series ? seriesMeta[data.series] ?? data.series : undefined;
const hasMeta = Boolean(seriesLabel || data.duration || difficulty || data.tags?.length);
---

{
  isSplash ? (
    <h1 id="_top" class="cs-page-title">
      {data.title}
    </h1>
  ) : (
    <>
      <nav class="cs-breadcrumbs" aria-label="面包屑">
        {crumbs.map((crumb, index) => (
          <>
            {index > 0 && (
              <span class="cs-breadcrumb-sep" aria-hidden="true">
                ›
              </span>
            )}
            {crumb.href ? (
              <a href={crumb.href}>{crumb.label}</a>
            ) : (
              <span aria-current="page">{crumb.label}</span>
            )}
          </>
        ))}
      </nav>

      <div class="cs-title-row">
        <h1 id="_top" class="cs-page-title">
          {data.title}
        </h1>

        {isChapter && seriesSlug ? (
          <div class="cs-title-actions">
            <CompleteButton client:visible slug={entry.id} />
            <FavoriteButton
              client:visible
              slug={`series:${seriesSlug}`}
              label="收藏教程"
              activeLabel="已收藏教程"
            />
          </div>
        ) : isRoutePage ? (
          <div class="cs-title-actions">
            <FavoriteButton
              client:visible
              slug={routeSlug}
              label="收藏路线"
              activeLabel="已收藏路线"
            />
            <CompleteButton
              client:visible
              slug={routeSlug}
              label="标记路线完成"
              activeLabel="已完成路线"
              trackRecent={false}
            />
          </div>
        ) : null}
      </div>

      {hasMeta && (
        <p class="cs-page-meta">
          {seriesLabel && <span class="cs-meta-item">{seriesLabel}</span>}
          {data.duration && <span class="cs-meta-item">约 {data.duration} 分钟</span>}
          {difficulty && <span class="cs-meta-item">难度：{difficulty}</span>}
          {data.tags?.length > 0 && (
            <span class="cs-meta-item">标签：{data.tags.join(' / ')}</span>
          )}
        </p>
      )}

      {isChapter && seriesSlug && (
        <p class="cs-title-hint">进度与收藏保存在本机浏览器，无需登录</p>
      )}
    </>
  )
}
