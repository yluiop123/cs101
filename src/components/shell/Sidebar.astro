---
import { getCollection } from 'astro:content';
import { getSeries, getSeriesBySlug } from '@/lib/content';
import { withBase } from '@/lib/utils';
import { homeSections } from '@/data/catalog';
import { domainCategories } from '@/data/domains';
import { routeTitles, routePlan } from '@/data/route-plan';

const { entry } = Astro.locals.starlightRoute;
const path = Astro.url.pathname.replace(/^\/cs101/, '');
const match = path.match(/^\/tutorials\/([^/]+)\//);
const currentSeries = match ? await getSeriesBySlug(match[1]) : null;
const currentId = entry.id;
const isHome = !entry.id || entry.id === 'index';
const isDomainIndex = path === '/domain/' || path === '/domain';
const currentDomain = path.match(/^\/domain\/([^/]+)\//)?.[1];
const isComputerScience = path.startsWith('/computer-science');
const isTechStack = path.startsWith('/tech-stack');
// 具体路线页：左侧栏显示这条路线自己的板块（与正文各板块锚点联动）
const techRouteSlug = path.match(/^\/tech-stack\/([^/]+)\//)?.[1];
const routeTiers = techRouteSlug ? (routePlan[techRouteSlug] ?? []) : [];
const isTechRoutePage = isTechStack && routeTiers.length > 0;

// 学习路线页的左侧栏：按路线顺序列出全部技术路线
const routeOrder = Object.keys(routeTitles);
const techRoutes = isTechStack
  ? (await getCollection('docs'))
      .filter((item) => item.id.startsWith('tech-stack/') && item.id !== 'tech-stack/index')
      .map((item) => ({ slug: item.id.slice('tech-stack/'.length), name: item.data.title }))
      .sort((a, b) => {
        const ai = routeOrder.indexOf(a.slug);
        const bi = routeOrder.indexOf(b.slug);
        if (ai !== -1 || bi !== -1) return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
        return a.slug.localeCompare(b.slug);
      })
  : [];

const catalog =
  currentSeries || isHome || isDomainIndex || currentDomain || isComputerScience || isTechStack
    ? []
    : await getSeries();
---

{
  isHome ? (
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">教程目录</p>
      <ul class="cs-sidebar-sections">
        {homeSections.map((group) => (
          <li>
            <a href={`#${group.id}`} data-cs-section-link={group.id}>
              {group.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : isDomainIndex ? (
    // 领域总览页：左侧栏与正文一致，列出 4 个分类
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">应用领域</p>
      <ul class="cs-sidebar-sections">
        {domainCategories.map((category) => (
          <li>
            <a href={`#cat-${category.id}`} data-cs-section-link={`cat-${category.id}`}>
              {category.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : currentDomain ? (
    // 具体领域页：左侧栏显示这条领域路线自己的阶段（与正文板块锚点联动）
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">应用领域</p>
      <ul class="cs-sidebar-sections">
        {(routePlan[`domain-${currentDomain}`] ?? []).map((tier, index) => (
          <li>
            <a href={`#tier-${index}`} data-cs-section-link={`tier-${index}`}>
              {tier.name}
            </a>
          </li>
        ))}
      </ul>
      <a class="cs-sidebar-back" href={withBase('/domain/')}>
        全部应用领域 →
      </a>
    </div>
  ) : isComputerScience ? (
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">计算机科学</p>
      <ul class="cs-sidebar-sections">
        <li>
          <a
            href={withBase('/computer-science/')}
            aria-current={path === '/computer-science/' ? 'page' : undefined}
          >
            学习路线总览
          </a>
        </li>
        <li>
          <a
            href={withBase('/computer-science/zh/')}
            aria-current={path.startsWith('/computer-science/zh') ? 'page' : undefined}
          >
            国内版教程
          </a>
        </li>
        <li>
          <a
            href={withBase('/computer-science/ossu/')}
            aria-current={path.startsWith('/computer-science/ossu') ? 'page' : undefined}
          >
            OSSU 国际教程
          </a>
        </li>
      </ul>
    </div>
  ) : isTechRoutePage ? (
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">学习路线</p>
      <ul class="cs-sidebar-sections">
        {routeTiers.map((tier, index) => (
          <li>
            <a href={`#tier-${index}`} data-cs-section-link={`tier-${index}`}>
              {tier.name}
            </a>
            {tier.options?.length ? (
              <ul class="cs-sidebar-sub">
                {tier.options.map((option, optionIndex) => (
                  <li>
                    <a
                      href={`#tier-${index}-${optionIndex}`}
                      data-cs-section-link={`tier-${index}-${optionIndex}`}
                    >
                      {option.name}
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))}
      </ul>
      <a class="cs-sidebar-back" href={withBase('/tech-stack/')}>
        全部技术路线 →
      </a>
    </div>
  ) : isTechStack ? (
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">学习路线</p>
      <ul class="cs-sidebar-sections">
        {techRoutes.map((route) => (
          <li>
            <a
              href={withBase(`/tech-stack/${route.slug}/`)}
              aria-current={path === `/tech-stack/${route.slug}/` ? 'page' : undefined}
            >
              {route.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : currentSeries ? (
    <div class="cs-sidebar">
      <a class="cs-sidebar-series-title" href={withBase(`/tutorials/${currentSeries.slug}/`)}>
        {currentSeries.title}
      </a>
      <ol class="cs-sidebar-chapters">
        {currentSeries.chapters.map((chapter) => (
          <li>
            <a
              href={withBase(`/${chapter.id}/`)}
              aria-current={chapter.id === currentId ? 'page' : undefined}
            >
              {chapter.title}
            </a>
          </li>
        ))}
      </ol>
    </div>
  ) : (
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">教程目录</p>
      <ul class="cs-sidebar-catalog">
        {catalog.map((item) => (
          <li>
            <a href={withBase(`/tutorials/${item.slug}/`)}>
              <span>{item.title}</span>
              <span class="cs-sidebar-count">{item.chapters.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<script>
  // 首页左侧目录：点击定位到分组，滚动时高亮当前分组
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-cs-section-link]'),
  );

  if (links.length > 0) {
    // 移动端：点击后收起抽屉（同页锚点不会触发导航，需手动关闭 popover）
    for (const link of links) {
      link.addEventListener('click', () => {
        const sidebar = document.getElementById('starlight__sidebar') as
          | (HTMLElement & { hidePopover?: () => void })
          | null;
        if (sidebar?.matches(':popover-open')) sidebar.hidePopover?.();
      });
    }

    const idOf = (link: HTMLAnchorElement) => link.dataset.csSectionLink ?? '';
    const items = links
      .map((link) => ({ link, target: document.getElementById(idOf(link)) }))
      .filter((item): item is { link: HTMLAnchorElement; target: HTMLElement } =>
        Boolean(item.target),
      );

    if (items.length > 0) {
      // 点击后先锁定被点中的分组，避免「点 数据库 却高亮 DevOps」这类错位
      let lockedId: string | null = null;

      const setActive = (id: string | null) => {
        for (const item of items) {
          item.link.classList.toggle('is-active', id !== null && idOf(item.link) === id);
        }
      };

      const update = () => {
        if (lockedId !== null) return;
        const offset = 120;
        let current: (typeof items)[number] | null = null;
        for (const item of items) {
          if (item.target.getBoundingClientRect().top - offset <= 0) current = item;
        }
        // 滚到底时高亮最后一个分组（末尾分组无法顶到视口顶部）
        const atBottom =
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
        if (atBottom) current = items[items.length - 1];
        for (const item of items) item.link.classList.toggle('is-active', item === current);
      };

      const release = () => {
        if (lockedId === null) return;
        lockedId = null;
        update();
      };

      for (const item of items) {
        item.link.addEventListener('click', () => {
          lockedId = idOf(item.link);
          setActive(lockedId);
        });
      }

      // 带锚点进入页面时，先高亮锚点对应的分组
      const initial = decodeURIComponent(window.location.hash.slice(1));
      if (initial && items.some((item) => idOf(item.link) === initial)) {
        lockedId = initial;
        setActive(initial);
      }

      // 用户自己滚动 / 按键浏览时解除锁定，回到按位置高亮
      window.addEventListener('wheel', release, { passive: true });
      window.addEventListener('touchstart', release, { passive: true });
      window.addEventListener(
        'keydown',
        (event) => {
          if (
            ['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(event.key)
          ) {
            release();
          }
        },
        { passive: true },
      );

      update();
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            update();
          });
        },
        { passive: true },
      );
      window.addEventListener('resize', update, { passive: true });
    }
  }
</script>
