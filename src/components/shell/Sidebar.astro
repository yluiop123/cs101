---
import { getSeries, getSeriesBySlug } from '@/lib/content';
import { withBase } from '@/lib/utils';

const { entry } = Astro.locals.starlightRoute;
const path = Astro.url.pathname.replace(/^\/cs101/, '');
const match = path.match(/^\/tutorials\/([^/]+)\//);
const currentSeries = match ? await getSeriesBySlug(match[1]) : null;
const currentId = entry.id;
const catalog = currentSeries ? [] : await getSeries();
---

{
  currentSeries ? (
    <div class="cs-sidebar">
      <a class="cs-sidebar-series-title" href={withBase(`/tutorials/${currentSeries.slug}/`)}>
        {currentSeries.title}
      </a>
      <ol class="cs-sidebar-chapters">
        {currentSeries.chapters.map((chapter) => (
          <li>
            <a
              href={withBase(`/${chapter.id}/`)}
              aria-current={chapter.id === currentId ? 'page' : undefined}
            >
              {chapter.title}
            </a>
          </li>
        ))}
      </ol>
    </div>
  ) : (
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">教程目录</p>
      <ul class="cs-sidebar-catalog">
        {catalog.map((item) => (
          <li>
            <a href={withBase(`/tutorials/${item.slug}/`)}>
              <span>{item.title}</span>
              <span class="cs-sidebar-count">{item.chapters.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
