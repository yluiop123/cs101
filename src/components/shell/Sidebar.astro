---
import { getCollection } from 'astro:content';
import { getSeries, getSeriesBySlug } from '@/lib/content';
import { withBase } from '@/lib/utils';
import { businessSystems, domainCatalog, homeCatalog } from '@/data/entries';
import { techRouteOrder } from '@/data/routes';

const { entry } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length) || '/';
const seriesMatch =
  path.match(/^\/tutorials\/([^/]+)\//) ?? path.match(/^\/business-systems\/([^/]+)\//);
// 业务系统的系列 slug 带 business- 前缀（避免与普通教程重名）
const currentSeriesSlug = seriesMatch
  ? path.startsWith('/business-systems/')
    ? `business-${seriesMatch[1]}`
    : seriesMatch[1]
  : undefined;
const currentSeries = currentSeriesSlug ? await getSeriesBySlug(currentSeriesSlug) : null;
const currentId = entry.id;
const isHome = !entry.id || entry.id === 'index';
const isDomainIndex = path === '/domain/' || path === '/domain';
const currentDomain = path.match(/^\/domain\/([^/]+)\//)?.[1];
const isComputerScienceRoute = /^\/computer-science\/(zh|en)\//.test(path);
// 业务系统总览页（系列页由 currentSeries 分支处理）
const isBusinessSystems = path === '/business-systems/' || path === '/business-systems';
const isTechStackIndex = path === '/tech-stack/' || path === '/tech-stack';
const isTechRoute = path.startsWith('/tech-stack/') && !isTechStackIndex;

// 四条目录页 = 直接列出分节/分类；单条路线页 = 列出本页分节锚点（数据在页面 MDX 里，侧栏读不到，
// 由页面底部的脚本从 .cs-card-section 采集）。
const routePage = isTechRoute
  ? { kicker: '学习路线', back: '/tech-stack/', backLabel: '全部技术路线' }
  : currentDomain
    ? { kicker: '应用领域', back: '/domain/', backLabel: '全部应用领域' }
    : isComputerScienceRoute
      ? { kicker: path.includes('/en') ? '国际教程' : '国内教程' }
      : undefined;

// 技术路线总览页的左侧栏：按路线顺序列出全部技术路线
const routeOrder = techRouteOrder;
const techRoutes = isTechStackIndex
  ? (await getCollection('docs'))
      .filter((item) => item.id.startsWith('tech-stack/') && item.id !== 'tech-stack/index')
      .map((item) => ({ slug: item.id.slice('tech-stack/'.length), name: item.data.title }))
      .sort((a, b) => {
        const ai = routeOrder.indexOf(a.slug);
        const bi = routeOrder.indexOf(b.slug);
        if (ai !== -1 || bi !== -1) return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
        return a.slug.localeCompare(b.slug);
      })
  : [];

const catalog =
  currentSeries ||
  isHome ||
  isDomainIndex ||
  currentDomain ||
  isComputerScienceRoute ||
  isTechStackIndex ||
  isTechRoute
    ? []
    : await getSeries();
---

{
  isHome ? (
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">技术分类</p>
      <ul class="cs-sidebar-sections">
        {homeCatalog.map((category) => (
          <li>
            <a href={`#${category.id}`} data-cs-section-link={category.id}>
              {category.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : isDomainIndex ? (
    // 领域总览页：左侧栏与正文一致，列出 8 个分类
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">应用领域</p>
      <ul class="cs-sidebar-sections">
        {domainCatalog.map((category) => (
          <li>
            <a href={`#${category.id}`} data-cs-section-link={category.id}>
              {category.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : routePage ? (
    // 单条路线页（技术路线 / 领域路线 / 计算机科学）：列出本页分节，锚点由页面脚本采集
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">{routePage.kicker}</p>
      <ul class="cs-sidebar-sections" data-cs-sections-auto></ul>
      {routePage.back && (
        <a class="cs-sidebar-back" href={withBase(routePage.back)}>
          {routePage.backLabel} →
        </a>
      )}
    </div>
  ) : isBusinessSystems ? (
    // 业务系统总览页：左侧栏按 14 个分类锚点联动
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">业务系统</p>
      <ul class="cs-sidebar-sections">
        {businessSystems.map((category) => (
          <li>
            <a href={`#${category.id}`} data-cs-section-link={category.id}>
              {category.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : isTechStackIndex ? (
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">学习路线</p>
      <ul class="cs-sidebar-sections">
        {techRoutes.map((route) => (
          <li>
            <a href={withBase(`/tech-stack/${route.slug}/`)}>{route.name}</a>
          </li>
        ))}
      </ul>
      {path !== '/tech-stack/' && path !== '/tech-stack' && (
        <a class="cs-sidebar-back" href={withBase('/tech-stack/')}>
          全部技术路线 →
        </a>
      )}
    </div>
  ) : currentSeries ? (
    <div class="cs-sidebar">
      <a class="cs-sidebar-series-title" href={withBase(currentSeries.href)}>
        {currentSeries.title}
      </a>
      <ol class="cs-sidebar-chapters">
        {currentSeries.chapters.map((chapter) => (
          <li>
            <a
              href={withBase(`/${chapter.id}/`)}
              aria-current={chapter.id === currentId ? 'page' : undefined}
            >
              {chapter.title}
            </a>
          </li>
        ))}
      </ol>
    </div>
  ) : (
    <div class="cs-sidebar">
      <p class="cs-sidebar-kicker">教程目录</p>
      <ul class="cs-sidebar-catalog">
        {catalog.map((item) => (
          <li>
            <a href={withBase(item.href)}>
              <span>{item.title}</span>
              <span class="cs-sidebar-count">{item.chapters.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<script>
  // 单条路线页：分节数据写在页面 MDX 里，左侧栏拿不到，从渲染结果里采集锚点
  for (const list of document.querySelectorAll<HTMLElement>('[data-cs-sections-auto]')) {
    if (list.children.length > 0) continue;
    for (const section of document.querySelectorAll<HTMLElement>('.cs-card-section')) {
      const id = section.id;
      const title = section.dataset.csTitle;
      if (!id || !title) continue;
      const li = document.createElement('li');
      const link = document.createElement('a');
      link.href = `#${id}`;
      link.dataset.csSectionLink = id;
      link.textContent = title;
      li.append(link);
      list.append(li);
    }
  }

  // 目录页 / 路线页左侧目录：点击定位到分组，滚动时高亮当前分组
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-cs-section-link]'),
  );

  if (links.length > 0) {
    // 移动端：点击后收起抽屉（同页锚点不会触发导航，需手动关闭 popover）
    for (const link of links) {
      link.addEventListener('click', () => {
        const sidebar = document.getElementById('starlight__sidebar') as
          | (HTMLElement & { hidePopover?: () => void })
          | null;
        if (sidebar?.matches(':popover-open')) sidebar.hidePopover?.();
      });
    }

    const idOf = (link: HTMLAnchorElement) => link.dataset.csSectionLink ?? '';
    const items = links
      .map((link) => ({ link, target: document.getElementById(idOf(link)) }))
      .filter((item): item is { link: HTMLAnchorElement; target: HTMLElement } =>
        Boolean(item.target),
      );

    if (items.length > 0) {
      // 点击后先锁定被点中的分组，避免「点 数据库 却高亮 DevOps」这类错位
      let lockedId: string | null = null;

      const setActive = (id: string | null) => {
        for (const item of items) {
          item.link.classList.toggle('is-active', id !== null && idOf(item.link) === id);
        }
      };

      const update = () => {
        if (lockedId !== null) return;
        const offset = 120;
        let current: (typeof items)[number] | null = null;
        for (const item of items) {
          if (item.target.getBoundingClientRect().top - offset <= 0) current = item;
        }
        // 滚到底时高亮最后一个分组（末尾分组无法顶到视口顶部）
        const atBottom =
          document.documentElement.scrollHeight > window.innerHeight + 2 &&
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
        if (atBottom) current = items[items.length - 1];
        for (const item of items) item.link.classList.toggle('is-active', item === current);
      };

      const release = () => {
        if (lockedId === null) return;
        lockedId = null;
        update();
      };

      for (const item of items) {
        item.link.addEventListener('click', () => {
          lockedId = idOf(item.link);
          setActive(lockedId);
        });
      }

      // 带锚点进入页面时，先高亮锚点对应的分组
      const initial = decodeURIComponent(window.location.hash.slice(1));
      if (initial && items.some((item) => idOf(item.link) === initial)) {
        lockedId = initial;
        setActive(initial);
      }

      // 用户自己滚动 / 按键浏览时解除锁定，回到按位置高亮
      window.addEventListener('wheel', release, { passive: true });
      window.addEventListener('touchstart', release, { passive: true });
      window.addEventListener(
        'keydown',
        (event) => {
          if (
            ['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(event.key)
          ) {
            release();
          }
        },
        { passive: true },
      );

      update();
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            update();
          });
        },
        { passive: true },
      );
      window.addEventListener('resize', update, { passive: true });
    }
  }
</script>
