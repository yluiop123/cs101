---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import SearchLauncher from '@/components/search/SearchLauncher.tsx';
import { siteSections } from '@/data/navigation';
import { withBase } from '@/lib/utils';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length) || '/';
---

<header class="header cs-header">
  <div class="cs-header-inner">
    <MobileMenuToggle />
    <div class="cs-header-brand">
      <SiteTitle />
    </div>
    <nav class="cs-topnav" aria-label="主导航">
      {
        siteSections.map((item) =>
          item.menu ? (
            <details
              class="cs-topnav-menu"
              data-active={item.matches(path) ? 'true' : undefined}
            >
              <summary>
                {item.label}
                <span class="cs-topnav-caret" aria-hidden="true">
                  ▾
                </span>
              </summary>
              <div class="cs-topnav-dropdown">
                {item.menu.map((link) => (
                  <a
                    href={withBase(link.href)}
                    aria-current={path === link.href ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a
              href={withBase(item.href ?? '/')}
              aria-current={item.matches(path) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>
    <div class="cs-header-actions">
      <SearchLauncher client:idle />
      <ThemeSelect />
    </div>
  </div>
</header>

<script>
  // 顶部导航下拉：点击外部或按 Esc 收起，Esc 收起后焦点回到展开按钮
  const menus = document.querySelectorAll<HTMLDetailsElement>('.cs-topnav-menu');
  if (menus.length > 0) {
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      for (const menu of menus) {
        if (menu.open && !menu.contains(target)) menu.open = false;
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      for (const menu of menus) {
        if (!menu.open) continue;
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
