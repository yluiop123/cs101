---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import SearchLauncher from '@/components/search/SearchLauncher.tsx';
import { withBase } from '@/lib/utils';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length) || '/';

const navItems = [
  {
    label: '首页',
    href: '/',
    // 教程页与技术路线页都属于「首页」板块
    matches: (value: string) =>
      value === '/' ||
      value === '' ||
      value.startsWith('/tutorials') ||
      value.startsWith('/tech-stack'),
  },
  { label: '应用领域', href: '/domain/', matches: (value: string) => value.startsWith('/domain') },
  {
    label: '业务系统',
    href: '/business-systems/',
    matches: (value: string) => value.startsWith('/business-systems'),
  },
  {
    label: '计算机科学',
    href: '/computer-science/',
    matches: (value: string) => value.startsWith('/computer-science'),
  },
];

// 在线演练不再自建：直接引导到成熟的在线编辑器（新标签页打开）
const tools = [
  { label: 'CodePen', href: 'https://codepen.io/pen/', note: 'HTML / CSS / JavaScript' },
  { label: 'StackBlitz', href: 'https://stackblitz.com/', note: '前端工程 / Node.js 项目' },
  {
    label: 'TypeScript Playground',
    href: 'https://www.typescriptlang.org/play',
    note: 'TypeScript 类型检查',
  },
];
---

<header class="header cs-header">
  <div class="cs-header-inner">
    <MobileMenuToggle />
    <div class="cs-header-brand">
      <SiteTitle />
    </div>
    <nav class="cs-topnav" aria-label="主导航">
      {
        navItems.map((item) => (
          <a href={withBase(item.href)} aria-current={item.matches(path) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <details class="cs-topnav-tools">
        <summary>
          在线演练<span class="cs-topnav-caret" aria-hidden="true">▾</span>
        </summary>
        <div class="cs-topnav-tools-menu">
          {
            tools.map((tool) => (
              <a href={tool.href} target="_blank" rel="noopener noreferrer">
                <span>{tool.label}</span>
                <small>{tool.note}</small>
              </a>
            ))
          }
        </div>
      </details>
    </nav>
    <div class="cs-header-actions">
      <SearchLauncher client:idle />
      <ThemeSelect />
    </div>
  </div>
</header>

<script>
  // 「在线演练」下拉：点击外部或按 Esc 收起
  const toolsMenu = document.querySelector<HTMLDetailsElement>('.cs-topnav-tools');
  if (toolsMenu) {
    document.addEventListener('click', (event) => {
      if (toolsMenu.open && !toolsMenu.contains(event.target as Node)) toolsMenu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') toolsMenu.open = false;
    });
  }
</script>
