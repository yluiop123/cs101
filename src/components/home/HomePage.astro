---
import { getSeries } from '@/lib/content';
import ContinueCard from '@/components/progress/ContinueCard.tsx';
import CardSection from '@/components/shared/CardSection.astro';
import { homeSections, type CatalogTutorial } from '@/data/catalog';
import { routePlan, seriesMeta, tierSlugs } from '@/data/route-plan';
import type { CardSectionData } from '@/data/cards';

const series = await getSeries();
const bySlug = new Map(series.map((item) => [item.slug, item]));

// 有学习路线的分组：内容直接取该路线的全部技术项，保证首页与「学习路线 →」一致
const routeTutorials = (roadmap?: string): CatalogTutorial[] => {
  if (!roadmap) return [];
  const key = roadmap.replace(/^\/tech-stack\//, '').replace(/\/$/, '');
  const slugs = [...new Set((routePlan[key] ?? []).flatMap((tier) => tierSlugs(tier)))];
  return slugs.map((slug) => ({ slug, title: seriesMeta[slug] ?? slug }));
};

const sections: CardSectionData[] = homeSections.map((group) => {
  const tutorials = group.tutorials ?? routeTutorials(group.roadmap);
  return {
    id: group.id,
    title: group.name,
    more: group.roadmap ? { href: group.roadmap } : undefined,
    items: tutorials.map((tutorial) => {
      const found = bySlug.get(tutorial.slug);
      return {
        title: tutorial.title,
        href: found ? `/tutorials/${tutorial.slug}/` : undefined,
        meta: found ? `${found.chapters.length} 章` : '敬请期待',
      };
    }),
  };
});
---

<div class="cs-home">
  <h1 class="sr-only">中文计算机学习路径</h1>

  <ContinueCard client:visible series={series} />

  {sections.map((section) => <CardSection {...section} />)}
</div>
