---
import { getSeries } from '@/lib/content';
import { withBase } from '@/lib/utils';
import ContinueCard from '@/components/progress/ContinueCard.tsx';

const series = await getSeries();
---

<div class="cs-home">
  <section class="cs-hero">
    <p class="cs-hero-kicker">CS101</p>
    <h1 class="cs-hero-title">中文计算机学习路径</h1>
    <p class="cs-hero-sub">技术栈 · 应用领域 · 计算机科学 —— 找到属于你的学习路径</p>
    <button type="button" class="cs-search-entry" data-search-open>
      <span>搜索技术栈、路线、章节…</span>
      <kbd>⌘K</kbd>
    </button>
    <div class="cs-hero-actions">
      <a class="cs-btn cs-btn-primary" href={withBase('/tech-stack/')}>看技术栈路线</a>
      <a class="cs-btn" href={withBase('/domain/')}>按应用领域选</a>
    </div>
  </section>

  <ContinueCard client:visible series={series} />

  <section>
    <h2 class="cs-section-title">按主题开始</h2>
    <div class="cs-cat-grid">
      <a class="cs-cat-card" href={withBase('/tech-stack/')}>
        <h3>技术栈</h3>
        <p>以语言或技术为核心，规划从入门到实战的路线。</p>
        <span class="cs-cat-link">进入 →</span>
      </a>
      <a class="cs-cat-card" href={withBase('/domain/')}>
        <h3>应用领域</h3>
        <p>从业务与行业出发，匹配完整技术栈。</p>
        <span class="cs-cat-link">进入 →</span>
      </a>
      <a class="cs-cat-card" href={withBase('/computer-science/')}>
        <h3>计算机科学</h3>
        <p>国内课程与 OSSU 国际路线，打牢底层基础。</p>
        <span class="cs-cat-link">进入 →</span>
      </a>
      <a class="cs-cat-card" href={withBase('/playground/')}>
        <h3>演练场</h3>
        <p>在浏览器里编辑并运行 JavaScript / HTML / CSS 示例。</p>
        <span class="cs-cat-link">进入 →</span>
      </a>
    </div>
  </section>
</div>
