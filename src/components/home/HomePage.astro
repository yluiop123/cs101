---
import { getSeries } from '@/lib/content';
import { withBase } from '@/lib/utils';
import ContinueCard from '@/components/progress/ContinueCard.tsx';
import { languageGroups, techGroups, type CatalogGroup, type CatalogTutorial } from '@/data/catalog';

const series = await getSeries();
const bySlug = new Map(series.map((item) => [item.slug, item]));

const resolve = (group: CatalogGroup, anchorPrefix: string) => ({
  ...group,
  anchor: `${anchorPrefix}-${group.id}`,
  tutorials: group.tutorials.map((tutorial: CatalogTutorial) => {
    const found = bySlug.get(tutorial.slug);
    return {
      ...tutorial,
      available: Boolean(found),
      chapters: found?.chapters.length ?? 0,
    };
  }),
});

// 每个编程语言与数据库 / 中间件 / 运维与云 / 工具与基础同级成组
const sections = [
  ...languageGroups.map((group) => resolve(group, 'lang')),
  ...techGroups.map((group) => resolve(group, 'tech')),
];

const availableCount = sections
  .flatMap((section) => section.tutorials)
  .filter((tutorial) => tutorial.available).length;
---

<div class="cs-home">
  <section class="cs-hero">
    <p class="cs-hero-kicker">CS101</p>
    <h1 class="cs-hero-title">中文计算机学习路径</h1>
    <p class="cs-hero-sub">
      {availableCount} 门中文教程，按编程语言与技术整理；另有 应用领域 · 计算机科学 · 演练场
    </p>
    <button type="button" class="cs-search-entry" data-search-open>
      <span>搜索教程、章节、技术路线…</span>
      <kbd>⌘K</kbd>
    </button>
    <div class="cs-hero-actions">
      <a class="cs-btn cs-btn-primary" href="#lang-java">浏览教程目录</a>
      <a class="cs-btn" href={withBase('/domain/')}>按应用领域选</a>
    </div>
  </section>

  <ContinueCard client:visible series={series} />

  {
    sections.map((section) => (
      <section id={section.anchor} class="cs-home-section">
        <div class="cs-section-head">
          <h2 class="cs-section-title">{section.name}</h2>
          {section.roadmap && (
            <a class="cs-section-more" href={withBase(section.roadmap)}>
              技术路线 →
            </a>
          )}
        </div>
        <ul class="cs-tut-grid">
          {section.tutorials.map((tutorial) => (
            <li>
              {tutorial.available ? (
                <a class="cs-tut-card" href={withBase(`/tutorials/${tutorial.slug}/`)}>
                  <span>{tutorial.title}</span>
                  <span class="cs-tut-meta">{tutorial.chapters} 章</span>
                </a>
              ) : (
                <span class="cs-tut-card is-planned">
                  <span>{tutorial.title}</span>
                  <span class="cs-tut-meta">敬请期待</span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
