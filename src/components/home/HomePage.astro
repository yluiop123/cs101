---
import { getSeries } from '@/lib/content';
import { withBase } from '@/lib/utils';
import ContinueCard from '@/components/progress/ContinueCard.tsx';
import { homeSections, type CatalogTutorial } from '@/data/catalog';
import { routePlan, seriesMeta } from '@/data/route-plan';

const series = await getSeries();
const bySlug = new Map(series.map((item) => [item.slug, item]));

// 有学习路线的分组：内容直接取该路线的全部技术项，保证首页与「学习路线 →」一致
const routeTutorials = (roadmap?: string): CatalogTutorial[] => {
  if (!roadmap) return [];
  const key = roadmap.replace(/^\/tech-stack\//, '').replace(/\/$/, '');
  const slugs = [...new Set((routePlan[key] ?? []).flatMap((tier) => tier.items))];
  return slugs.map((slug) => ({ slug, title: seriesMeta[slug] ?? slug }));
};

const sections = homeSections.map((group) => {
  const tutorials = (group.tutorials ?? routeTutorials(group.roadmap)).map(
    (tutorial: CatalogTutorial) => {
      const found = bySlug.get(tutorial.slug);
      return {
        ...tutorial,
        available: Boolean(found),
        chapters: found?.chapters.length ?? 0,
      };
    },
  );
  return { ...group, tutorials };
});
---

<div class="cs-home">
  <h1 class="sr-only">中文计算机学习路径</h1>

  <ContinueCard client:visible series={series} />

  {
    sections.map((section) => (
      <section id={section.id} class="cs-home-section">
        <div class="cs-section-head">
          <h2 class="cs-section-title">{section.name}</h2>
          {section.roadmap && (
            <a class="cs-section-more" href={withBase(section.roadmap)}>
              学习路线 →
            </a>
          )}
        </div>

        <ul class="cs-tut-grid">
          {section.tutorials.map((tutorial) => (
            <li>
              {tutorial.available ? (
                <a class="cs-tut-card" href={withBase(`/tutorials/${tutorial.slug}/`)}>
                  <span>{tutorial.title}</span>
                  <span class="cs-tut-meta">{tutorial.chapters} 章</span>
                </a>
              ) : (
                <span class="cs-tut-card is-planned">
                  <span>{tutorial.title}</span>
                  <span class="cs-tut-meta">敬请期待</span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
