---
import { getSeries } from '@/lib/content';
import ContinueCard from '@/components/progress/ContinueCard.tsx';
import CardSection from '@/components/shared/CardSection.astro';
import { homeCategories } from '@/data/catalog';
import type { CardSectionData } from '@/data/cards';

const series = await getSeries();

// 首页 = 12 个技术分类，每张卡片直接指向该方向的学习路线或教程
const sections: CardSectionData[] = homeCategories.map((category) => ({
  id: category.id,
  title: category.name,
  items: category.items.map((item) => ({ title: item.title, href: item.href })),
}));
---

<div class="cs-home">
  <h1 class="sr-only">中文计算机学习路径</h1>

  <ContinueCard client:visible series={series} />

  {sections.map((section) => <CardSection {...section} />)}
</div>
